rules_version = '2';
// Правила доступа к базе «Склад и касса».
// Владелец определяется по Google-почте. Сотрудники — по документу staff/{uid},
// который создаёт владелец в разделе «Настройки» → «Сотрудники».
// lvl: 'admin' — склад, товары, поставщики, деньги; 'seller' — касса, покупатели, гарантия.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'kruznovsergej0@gmail.com';
    }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function isStaff() { return signedIn() && exists(staffPath()); }
    function me() { return get(staffPath()).data; }
    function member() { return isOwner() || (isStaff() && me().get('off', false) != true); }
    function admin()  { return isOwner() || (member() && me().get('lvl', 'seller') == 'admin'); }
    function hasPerm(p) { return isOwner() || (member() && p in me().get('perms', [])); }
    // Розничных покупателей меняет право 'customers', оптовых — 'custopt'
    function custOk(d) { return hasPerm(d.get('kind', 'retail') == 'opt' ? 'custopt' : 'customers'); }
    function seller() { return isOwner() || (member() && me().get('lvl', 'seller') in ['admin', 'seller']); }

    // Продажи, покупатели, гарантийные обращения — работают продавцы
    match /sales/{id}     { allow read: if member(); allow write: if seller(); }
    match /customers/{id} {
      allow read: if member();
      allow create: if seller() && custOk(request.resource.data);
      allow update: if seller() && custOk(resource.data) && custOk(request.resource.data);
      allow delete: if seller() && custOk(resource.data);
    }
    match /claims/{id}    { allow read: if member(); allow write: if seller(); }
    // Акты закупа у физлиц — право 'buy'; оприходование делает администратор, удаляет владелец
    match /buys/{id} {
      allow read: if member();
      allow create, update: if hasPerm('buy') || admin();
      allow delete: if isOwner();
    }

    // Прайсы поставщиков для расчёта ПК — не влияют на учёт
    match /pricelists/{id} { allow read: if member(); allow write: if isOwner(); }
    match /plrows/{id}     { allow read: if member(); allow write: if isOwner(); }

    // Витрина сайта: только название, категория и розничная цена — открыта всем, выгружает владелец.
    // Наценки по категориям видит и меняет только владелец.
    match /sitecat/{id} { allow read: if true; allow write: if isOwner(); }
    match /sitecfg/{id} { allow read, write: if isOwner(); }
    // Оптовый каталог для дилеров (страница opt/): документы optcat/{ключ}_* читаются только по точному адресу,
    // ключ — хеш общего логина и пароля дилеров. Перечислить их нельзя.
    match /optcat/{id} { allow get: if true; allow list: if false; allow write: if isOwner(); }
    match /optcfg/{id} { allow read, write: if isOwner(); }
    // Фото и описания товаров для оптового каталога
    match /optinfo/{id}  { allow get: if true; allow list: if member(); allow write: if admin() || hasPerm('catalog'); }
    match /optthumb/{id} { allow get: if true; allow list: if member(); allow write: if admin() || hasPerm('catalog'); }
    match /optidx/{id}   { allow read: if member(); allow write: if admin() || hasPerm('catalog'); }
    // Заказы дилеров: создать может тот, кто знает действующий ключ каталога; читают и обрабатывают продавцы
    match /optorders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['at','key','name','phone','comment','items','total','st'])
                    && request.resource.data.st == 'new'
                    && request.resource.data.key is string && request.resource.data.key.size() == 64
                    && exists(/databases/$(database)/documents/optcat/$(request.resource.data.key + '_m'))
                    && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 300
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
                    && request.resource.data.total is number;
      allow read, update, delete: if seller();
    }
    // Фото и описание готовых сборок для сайта: видят все, меняют сборщики
    match /pcphotos/{id} { allow read: if true; allow write: if admin() || hasPerm('assembly') || hasPerm('pcedit'); }

    // Счётчик посетителей сайта: любой может только прибавить 1
    match /sitestats/{id} {
      allow read: if true;
      allow create: if id == 'main' && request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1;
      allow update: if id == 'main' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
                    && request.resource.data.visits == resource.data.visits + 1;
    }
    // «Сейчас на сайте»: отметка времени посетителя, без личных данных
    match /siteonline/{id} {
      allow read: if true;
      allow create, update: if id.size() <= 40 && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
    }

    // Справочники и складские документы — видят все, меняют администраторы
    match /warehouses/{id} { allow read: if member(); allow write: if admin(); }
    match /products/{id}   { allow read: if member(); allow write: if admin(); }
    match /groups/{id}     { allow read: if member(); allow write: if admin(); }
    match /settings/{id}   { allow read: if member(); allow write: if admin(); }
    match /ops/{id}        { allow read: if member(); allow write: if admin(); }

    // Себестоимость, поставщики, деньги, заказы — только администраторы
    match /costs/{id}     { allow read, write: if admin(); }
    match /opcosts/{id}   { allow read, write: if admin(); }
    match /suppliers/{id} { allow read, write: if admin(); }
    match /suppays/{id}   { allow read, write: if admin(); }
    match /money/{id}     { allow read, write: if admin(); }
    match /pos/{id}       { allow read, write: if admin(); }

    // Сотрудники: список видят все сотрудники, свою запись — сам человек, меняет только владелец
    match /staff/{uid} {
      allow read: if member() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // Кто входил в программу: каждый пишет только о себе, весь список видит владелец
    match /seen/{uid} {
      allow read, write: if isOwner() || (signedIn() && request.auth.uid == uid);
    }
  }
}
